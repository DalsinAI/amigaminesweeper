# Minesweeper for GFOS (AmigaOS 3.2 with GFOpenUp), 68040/68060: upstream's
# curses game in its own 80 x 24 console window, in colour, built soft
# float (the stove's fpuauto uses the FPU when the Amiga has one). No SDL,
# no ACGame, no GFOpenGPU. Upstream's GTK front end (src/gui.c) and its
# Python module are not built.
#
#   make -f amiga/Makefile.amigaos -j4 UP=/path/to/minesweeper [STOVE=...]
#
# UP is upstream at package/minesweeper.lock's commit, with amiga/patches
# applied (package/build-amiga.sh does both). STOVE is a GFOpenAmigaGCC
# 16.2.0-open6 stove (prefix/ has the compiler and the NDK).
# The game draws through amiga/curses.c (the part of ncurses it uses, sent
# to the console as ANSI with the eight pens for colour: the layer of
# DalsinAI/amiga2048 and amiganinvaders); amiga/console_amiga.c opens the
# window and reads the keys (amiga/keys.c: the cursor keys as KEY_*).
#
# Output: build/amigaos/Minesweeper/ (the drawer: Minesweeper, ReadMe, the
# licence, GlowIcons), build/amigaos/Minesweeper.info and
# Install-Minesweeper beside them.

UP      ?= ../minesweeper
STOVE   ?= $(HOME)/AmiCradle/stoves/os32-gcc16-open6
PREFIX  ?= $(STOVE)/prefix
CC      = $(PREFIX)/bin/m68k-amigaos-gcc
CPU     ?= -m68040 -msoft-float
# -fno-tree-loop-distribute-patterns: GCC 16's loop miscompile.
OPT     ?= -Os -fomit-frame-pointer -fno-tree-loop-distribute-patterns

UPFLAGS = -noixemul $(OPT) $(CPU) -std=gnu99 -D__amigaos__ -w \
          -Werror=implicit-function-declaration -Iamiga/include -Iamiga -I$(UP)/src
MYFLAGS = -noixemul $(OPT) $(CPU) -std=gnu99 -Wall -Iamiga/include -Iamiga \
          -DAMIGA_GAME_TITLE='"Minesweeper"'
LDFLAGS = -noixemul $(CPU)

BUILD   = build/amigaos
OBJ     = $(BUILD)/obj
OUT     = $(BUILD)/Minesweeper

GAME    = minesweeper cli curses main
PORT    = curses keys console_amiga

all: $(OUT)/Minesweeper package

$(OBJ)/up/%.o: $(UP)/src/%.c $(UP)/src/minesweeper.h $(wildcard amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(UPFLAGS) -c -o $@ $<

$(OBJ)/port/%.o: amiga/%.c $(wildcard amiga/*.h amiga/include/*.h)
	@mkdir -p $(dir $@)
	$(CC) $(MYFLAGS) -c -o $@ $<

$(OUT)/Minesweeper: $(GAME:%=$(OBJ)/up/%.o) $(PORT:%=$(OBJ)/port/%.o)
	@mkdir -p $(OUT)
	$(CC) $(LDFLAGS) -o $@ $^

package: $(OUT)/Minesweeper AMIGA_PORT.md
	cp AMIGA_PORT.md $(OUT)/ReadMe
	cp $(UP)/LICENSE.txt $(OUT)/LICENSE.txt
	cp amiga/icons/Minesweeper.info amiga/icons/ReadMe.info $(OUT)/
	cp amiga/icons/ReadMe.info $(OUT)/LICENSE.txt.info
	cp amiga/icons/Minesweeper-drawer.info $(BUILD)/Minesweeper.info
	cp amiga/Install-Minesweeper amiga/Install-Minesweeper.info $(BUILD)/

clean:
	rm -rf $(BUILD)

.PHONY: all package clean
